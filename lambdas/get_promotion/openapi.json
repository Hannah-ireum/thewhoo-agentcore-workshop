{
  "openapi": "3.0.0",
  "info": {
    "title": "get_promotion",
    "version": "1.0.0",
    "description": "현재 진행 중인 프로모션(할인, 증정, 쿠폰 등)을 조회합니다. product_id 또는 category 중 하나를 지정하면 해당 대상에 적용 가능한 프로모션만 반환하며, 둘 다 비우면 전체 프로모션을 돌려줍니다."
  },
  "paths": {
    "/": {
      "post": {
        "operationId": "get_promotion",
        "summary": "프로모션 조회",
        "description": "상품 ID 혹은 카테고리명에 해당하는 할인/증정/쿠폰 프로모션 리스트를 반환합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string",
                    "description": "상품 ID. 예: 'WHOO-00101'"
                  },
                  "category": {
                    "type": "string",
                    "description": "카테고리 이름. 예: '스킨케어', '향수'"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "프로모션 리스트",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {"type": "integer"},
                    "promotions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "promotion_id": {"type": "string"},
                          "title": {"type": "string"},
                          "benefit": {"type": "string"},
                          "period": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
