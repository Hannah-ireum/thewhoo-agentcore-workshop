{
  "openapi": "3.0.0",
  "info": {
    "title": "check_stock",
    "version": "1.0.0",
    "description": "특정 상품의 현재 재고 보유 여부와 배송 예정일을 조회합니다. product_id가 반드시 필요하며, 상품을 먼저 product_search 또는 recommend_products로 찾은 뒤 호출하세요."
  },
  "paths": {
    "/": {
      "post": {
        "operationId": "check_stock",
        "summary": "상품 재고/배송 조회",
        "description": "product_id를 받아 available(true/false), eta(배송 예정), note(품절 시 안내)를 반환합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["product_id"],
                "properties": {
                  "product_id": {
                    "type": "string",
                    "description": "상품 ID. 예: 'WHOO-00101'"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "재고 상태",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "product_id": {"type": "string"},
                    "available": {"type": "boolean"},
                    "eta": {"type": "string", "nullable": true},
                    "note": {"type": "string", "nullable": true}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
